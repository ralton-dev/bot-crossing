# Installed and built inside the image, never copied in from the context.
node_modules
dist

# Your colony, and local capture output. Neither belongs in an image.
data
recordings

# Raw art packs (not in the repository anyway) and the character design sources. The packed
# glbs under public/assets are what ships; see TRADEMARKS.md for why the sources do not.
assets-src
design

# The laptop half: a launchd plist and a menu bar plugin, both macOS-only and both meaningless
# to a Linux container. `tools/` itself has to come in for the asset packers.
tools/swiftbar
tools/launchd

.git

# Sound samples are licensed for use in a work, not for redistribution. The README explains
# how to drop your own in at runtime; the image ships none.
public/audio/*
!public/audio/README.md
